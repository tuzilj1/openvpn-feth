+/*
+ * Kext-less tap on macOS using a feth(4) interface pair (same approach as
+ * ZeroTier):
+ *
+ *   OS stack <-> fethA (visible, gets the ifconfig) <-peer-> fethB <-> OpenVPN
+ *
+ * Frames the OS sends out of fethA appear on fethB and are captured with BPF;
+ * frames from the VPN are sent out of fethB with an AF_NDRV socket and arrive
+ * on fethA as received traffic.  A reader thread splits BPF buffers into
+ * single frames and passes them over a datagram socketpair, so tt->fd behaves
+ * like a tap fd (one frame per read) for the event loop.
+ */
+
+#define FETH_SOCKBUF  (1024 * 1024)
+#define FETH_BPF_BUF  (128 * 1024)
+
+struct darwin_feth
+{
+    char peer[IFNAMSIZ];   /* fethB, the OpenVPN side of the pair */
+    int ndrv_fd;           /* write side: send frames out of fethB */
+    int bpf_fd;            /* read side: capture frames arriving on fethB */
+    u_int bpf_buflen;
+    int pair[2];           /* [0] = tt->fd, [1] = reader thread */
+    pthread_t reader;
+    bool reader_started;
+    volatile bool stop;
+    /* dropped frames, logged on close */
+    unsigned long write_drops;     /* VPN -> OS, send() on AF_NDRV failed */
+    int write_errno;
+    volatile unsigned long read_drops; /* OS -> VPN, socketpair queue full */
+};
+
+static bool
+feth_create(char *name)
+{
+    struct ifreq ifr;
+    bool ret = false;
+    int s = socket(AF_INET, SOCK_DGRAM, 0);
+
+    CLEAR(ifr);
+    strncpynt(ifr.ifr_name, "feth", sizeof(ifr.ifr_name));
+    if (s >= 0 && ioctl(s, SIOCIFCREATE, &ifr) == 0)
+    {
+        strncpynt(name, ifr.ifr_name, IFNAMSIZ);
+        ret = true;
+    }
+    else
+    {
+        msg(M_WARN | M_ERRNO, "feth: cannot create interface");
+    }
+    if (s >= 0)
+    {
+        close(s);
+    }
+    return ret;
+}
+
+static void
+feth_destroy(const char *name)
+{
+    struct ifreq ifr;
+    int s = socket(AF_INET, SOCK_DGRAM, 0);
+
+    CLEAR(ifr);
+    strncpynt(ifr.ifr_name, name, sizeof(ifr.ifr_name));
+    if (s < 0 || ioctl(s, SIOCIFDESTROY, &ifr) < 0)
+    {
+        msg(M_WARN | M_ERRNO, "feth: cannot destroy %s", name);
+    }
+    if (s >= 0)
+    {
+        close(s);
+    }
+}
+
+/*
+ * Ownership of a pair is recorded in FETH_STATE_DIR/<visible> as "<pid> <peer>".
+ * Unlike /dev/tapN, feth interfaces outlive a crashed (SIGKILLed) process with
+ * their address and routes, so every start removes pairs of dead owners.
+ */
+#define FETH_STATE_DIR "/var/run/openvpn-feth"
+
+static void
+feth_state_path(char *path, size_t len, const char *visible)
+{
+    snprintf(path, len, "%s/%s", FETH_STATE_DIR, visible);
+}
+
+static void
+feth_state_write(const char *visible, const char *peer)
+{
+    char path[64];
+    FILE *fp;
+
+    if (mkdir(FETH_STATE_DIR, 0700) < 0 && errno != EEXIST)
+    {
+        msg(M_WARN | M_ERRNO, "feth: cannot create %s", FETH_STATE_DIR);
+        return;
+    }
+    feth_state_path(path, sizeof(path), visible);
+    fp = fopen(path, "w");
+    if (!fp)
+    {
+        msg(M_WARN | M_ERRNO, "feth: cannot write %s", path);
+        return;
+    }
+    fprintf(fp, "%d %s\n", (int)getpid(), peer);
+    fclose(fp);
+}
+
+static void
+feth_state_remove(const char *visible)
+{
+    char path[64];
+    feth_state_path(path, sizeof(path), visible);
+    unlink(path);
+}
+
+static void
+feth_cleanup_stale(void)
+{
+    DIR *dir = opendir(FETH_STATE_DIR);
+    struct dirent *de;
+
+    if (!dir)
+    {
+        return;
+    }
+    while ((de = readdir(dir)) != NULL)
+    {
+        char path[64], peer[IFNAMSIZ];
+        int pid = 0;
+        FILE *fp;
+
+        if (strncmp(de->d_name, "feth", 4) != 0 || strlen(de->d_name) >= IFNAMSIZ)
+        {
+            continue;
+        }
+        feth_state_path(path, sizeof(path), de->d_name);
+        fp = fopen(path, "r");
+        if (!fp)
+        {
+            continue;
+        }
+        peer[0] = '\0';
+        if (fscanf(fp, "%d %15s", &pid, peer) != 2)
+        {
+            pid = 0;
+        }
+        fclose(fp);
+        if (pid > 0 && (kill(pid, 0) == 0 || errno != ESRCH))
+        {
+            continue; /* owner still running */
+        }
+        msg(M_INFO, "feth: removing stale pair %s/%s of dead process %d",
+            de->d_name, peer, pid);
+        if (if_nametoindex(de->d_name))
+        {
+            feth_destroy(de->d_name);
+        }
+        if (strncmp(peer, "feth", 4) == 0 && if_nametoindex(peer))
+        {
+            feth_destroy(peer);
+        }
+        unlink(path);
+    }
+    closedir(dir);
+}
+
+static int
+feth_open_bpf(const char *ifname, u_int *buflen)
+{
+    struct ifreq ifr;
+    struct timeval tv = { 0, 250000 };  /* lets the reader notice stop */
+    u_int on = 1, off = 0;
+    int fd = -1;
+
+    for (int i = 0; i < 256 && fd < 0; i++)
+    {
+        char dev[16];
+        snprintf(dev, sizeof(dev), "/dev/bpf%d", i);
+        fd = open(dev, O_RDWR);
+    }
+    if (fd < 0)
+    {
+        msg(M_WARN | M_ERRNO, "feth: cannot open a /dev/bpf device");
+        return -1;
+    }
+
+    *buflen = FETH_BPF_BUF;
+    CLEAR(ifr);
+    strncpynt(ifr.ifr_name, ifname, sizeof(ifr.ifr_name));
+    if (ioctl(fd, BIOCSBLEN, buflen) < 0
+        || ioctl(fd, BIOCSETIF, &ifr) < 0
+        || ioctl(fd, BIOCIMMEDIATE, &on) < 0
+        || ioctl(fd, BIOCSSEESENT, &off) < 0  /* not our own injected frames */
+        || ioctl(fd, BIOCPROMISC, NULL) < 0
+        || ioctl(fd, BIOCSRTIMEOUT, &tv) < 0
+        || ioctl(fd, BIOCGBLEN, buflen) < 0)
+    {
+        msg(M_WARN | M_ERRNO, "feth: cannot set up BPF on %s", ifname);
+        close(fd);
+        return -1;
+    }
+    set_cloexec(fd);
+    return fd;
+}
+
+static void *
+feth_reader(void *arg)
+{
+    struct darwin_feth *f = arg;
+    uint8_t *buf = malloc(f->bpf_buflen);
+
+    /* no msg() here, it is not thread safe */
+    while (buf && !f->stop)
+    {
+        ssize_t n = read(f->bpf_fd, buf, f->bpf_buflen);
+        if (n < 0)
+        {
+            if (errno == EINTR || errno == EAGAIN)
+            {
+                continue;
+            }
+            break;
+        }
+        for (uint8_t *p = buf; p < buf + n; )
+        {
+            const struct bpf_hdr *bh = (const struct bpf_hdr *)p;
+            if (bh->bh_caplen == bh->bh_datalen)
+            {
+                /* non-blocking: a full queue drops the frame like a busy NIC */
+                if (send(f->pair[1], p + bh->bh_hdrlen, bh->bh_caplen, 0) < 0)
+                {
+                    f->read_drops++;
+                }
+            }
+            p += BPF_WORDALIGN(bh->bh_hdrlen + bh->bh_caplen);
+        }
+    }
+    free(buf);
+    return NULL;
+}
+
+static void
+close_darwin_feth(struct tuntap *tt)
+{
+    struct darwin_feth *f = tt->feth;
+
+    if (!f)
+    {
+        return;
+    }
+    f->stop = true;
+    if (f->reader_started)
+    {
+        pthread_join(f->reader, NULL);
+    }
+    {
+        struct bpf_stat bs;
+        CLEAR(bs);
+        if (f->bpf_fd >= 0)
+        {
+            ioctl(f->bpf_fd, BIOCGSTATS, &bs);
+        }
+        msg(M_INFO, "feth: dropped frames: %lu to OS (last errno %d), %lu from OS "
+            "(queue), %u from OS (BPF, of %u captured)",
+            f->write_drops, f->write_errno, f->read_drops, bs.bs_drop, bs.bs_recv);
+    }
+    if (f->bpf_fd >= 0)
+    {
+        close(f->bpf_fd);
+    }
+    if (f->ndrv_fd >= 0)
+    {
+        close(f->ndrv_fd);
+    }
+    if (f->pair[1] >= 0)
+    {
+        close(f->pair[1]);
+    }
+    /* pair[0] is tt->fd, closed by close_tun_generic() */
+    if (f->peer[0])
+    {
+        feth_destroy(f->peer);
+    }
+    if (tt->actual_name)
+    {
+        feth_destroy(tt->actual_name);
+        feth_state_remove(tt->actual_name);
+    }
+    free(f);
+    tt->feth = NULL;
+}
+
+static void
+open_darwin_feth(struct tuntap *tt)
+{
+    struct darwin_feth *f;
+    struct argv argv = argv_new();
+    struct sockaddr_ndrv sa;
+    char visible[IFNAMSIZ] = "";
+    int sockbuf = FETH_SOCKBUF;
+
+    ALLOC_OBJ_CLEAR(f, struct darwin_feth);
+    f->ndrv_fd = f->bpf_fd = f->pair[0] = f->pair[1] = -1;
+    tt->feth = f;
+
+    feth_cleanup_stale();
+    if (!feth_create(visible))
+    {
+        goto error;
+    }
+    tt->actual_name = string_alloc(visible, NULL);
+    if (!feth_create(f->peer))
+    {
+        goto error;
+    }
+    feth_state_write(visible, f->peer);
+
+    argv_printf(&argv, "%s %s peer %s", IFCONFIG_PATH, visible, f->peer);
+    argv_msg(M_INFO, &argv);
+    if (!openvpn_execve_check(&argv, NULL, 0, "feth: setting peer failed"))
+    {
+        goto error;
+    }
+    /* the visible side gets its mtu from do_ifconfig(); feth caps both at 1500 */
+    argv_printf(&argv, "%s %s up", IFCONFIG_PATH, f->peer);
+    argv_msg(M_INFO, &argv);
+    if (!openvpn_execve_check(&argv, NULL, 0, "feth: bringing up peer failed"))
+    {
+        goto error;
+    }
+
+    /* feth MACs are derived from the unit number (66:65:74:68:00:00 for feth0),
+     * so every Mac would bring the same MAC into the bridged LAN */
+    {
+        uint8_t mac[6];
+        if (!rand_bytes(mac, sizeof(mac)))
+        {
+            goto error;
+        }
+        mac[0] = (mac[0] & 0xfe) | 0x02; /* unicast, locally administered */
+        argv_printf(&argv, "%s %s lladdr %02x:%02x:%02x:%02x:%02x:%02x", IFCONFIG_PATH,
+                    visible, mac[0], mac[1], mac[2], mac[3], mac[4], mac[5]);
+        argv_msg(M_INFO, &argv);
+        if (!openvpn_execve_check(&argv, NULL, 0, "feth: setting MAC address failed"))
+        {
+            goto error;
+        }
+    }
+
+    f->ndrv_fd = socket(AF_NDRV, SOCK_RAW, 0);
+    CLEAR(sa);
+    sa.snd_len = sizeof(sa);
+    sa.snd_family = AF_NDRV;
+    strncpynt((char *)sa.snd_name, f->peer, sizeof(sa.snd_name));
+    if (f->ndrv_fd < 0
+        || bind(f->ndrv_fd, (struct sockaddr *)&sa, sizeof(sa)) < 0
+        || connect(f->ndrv_fd, (struct sockaddr *)&sa, sizeof(sa)) < 0)
+    {
+        msg(M_WARN | M_ERRNO, "feth: cannot open AF_NDRV socket on %s", f->peer);
+        goto error;
+    }
+    set_nonblock(f->ndrv_fd);
+    set_cloexec(f->ndrv_fd);
+
+    f->bpf_fd = feth_open_bpf(f->peer, &f->bpf_buflen);
+    if (f->bpf_fd < 0)
+    {
+        goto error;
+    }
+
+    if (socketpair(AF_UNIX, SOCK_DGRAM, 0, f->pair) < 0)
+    {
+        msg(M_WARN | M_ERRNO, "feth: socketpair failed");
+        goto error;
+    }
+    setsockopt(f->pair[0], SOL_SOCKET, SO_RCVBUF, &sockbuf, sizeof(sockbuf));
+    setsockopt(f->pair[1], SOL_SOCKET, SO_SNDBUF, &sockbuf, sizeof(sockbuf));
+    set_nonblock(f->pair[0]);
+    set_nonblock(f->pair[1]);
+    set_cloexec(f->pair[0]);
+    set_cloexec(f->pair[1]);
+
+    if (pthread_create(&f->reader, NULL, feth_reader, f) != 0)
+    {
+        msg(M_WARN, "feth: cannot start reader thread");
+        goto error;
+    }
+    f->reader_started = true;
+
+    tt->fd = f->pair[0];
+    msg(M_INFO, "TUN/TAP device %s opened (feth tap emulation, peer %s)",
+        visible, f->peer);
+    argv_free(&argv);
+    return;
+
+error:
+    argv_free(&argv);
+    if (f->pair[0] >= 0)
+    {
+        close(f->pair[0]);
+    }
+    close_darwin_feth(tt);
+    msg(M_FATAL, "Cannot open feth tap emulation");
+}
+
 void
 open_tun(const char *dev, const char *dev_type, const char *dev_node, struct tuntap *tt,
          openvpn_net_ctx_t *ctx)
 {
+    /* tap without the tap kext: emulate it with feth, or on request (dev-node feth) */
+    if (tt->type == DEV_TYPE_TAP
+        && ((dev_node && strcmp(dev_node, "feth") == 0)
+            || (!dev_node && access("/dev/tap0", F_OK) != 0)))
+    {
+        if (!dev_node)
+        {
+            msg(M_INFO, "No tap kext loaded (/dev/tap0 missing), using feth tap emulation");
+        }
+        open_darwin_feth(tt);
+        return;
+    }
+
 #ifdef HAVE_NET_IF_UTUN_H
     /* If dev_node does not start start with utun assume regular tun/tap */
     if ((!dev_node && tt->type==DEV_TYPE_TUN)
@@ -3463,6 +3891,7 @@ close_tun(struct tuntap *tt, openvpn_net_ctx_t *ctx)
         openvpn_execve_check(&argv, NULL, 0, "MacOS X 'remove inet6 route' failed (non-critical)");
     }
 
+    close_darwin_feth(tt);
     close_tun_generic(tt);
     free(tt);
     argv_free(&argv);
@@ -3472,6 +3901,16 @@ close_tun(struct tuntap *tt, openvpn_net_ctx_t *ctx)
 int
 write_tun(struct tuntap *tt, uint8_t *buf, int len)
 {
+    if (tt->feth)
+    {
+        int ret = send(tt->feth->ndrv_fd, buf, len, 0);
+        if (ret < 0)
+        {
+            tt->feth->write_drops++;
+            tt->feth->write_errno = errno;
+        }
+        return ret;
+    }
 #ifdef HAVE_NET_IF_UTUN_H
     if (tt->is_utun)
     {
